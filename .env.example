# Copy this file to .env and fill in your credentials.
# Do NOT commit your real .env file to git.

# --- Binance API (optional for public endpoints like OHLCV/ticker) ---
# Required later for private endpoints: account balance, placing orders, etc.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# --- Polymarket API (to be used in later steps) ---
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_API_SECRET=your_polymarket_api_secret_here
POLYMARKET_PASSPHRASE=your_polymarket_passphrase_here
