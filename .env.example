# Copy this file to .env and fill in your credentials.
# Do NOT commit your real .env file to git.
#
# Phase 0 (verify_polymarket_access.py) does NOT require any of these —
# everything below is read in later phases only.

# --- Polymarket wallet (Phase 3: execution layer) ---
# Private key for the EOA that holds USDC on Polygon and signs CLOB orders.
# KEEP THIS SECRET. Use a dedicated wallet with only bot funds, never your
# main wallet.
POLYMARKET_PRIVATE_KEY=0xyour_private_key_here

# Proxy wallet address (Polymarket uses a proxy wallet pattern). Optional —
# only needed if you trade via a proxy instead of EOA directly.
POLYMARKET_PROXY_ADDRESS=

# Polygon RPC endpoint. Public endpoints are fine for light use; consider a
# dedicated provider (Alchemy/Infura) for production.
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Risk caps (Phase 4) ---
MAX_POSITION_USD=25        # per-trade cap
MAX_TOTAL_EXPOSURE_USD=250 # across all open positions
DAILY_LOSS_KILL_USD=15     # auto-pause if daily PnL below this

# --- Binance API (legacy, optional, used only by fetch_data.py utility) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
